<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer since Android 12 (#145): everything except the encrypted
     secrets, unreadable elsewhere (the Keystore key never leaves the device). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="seaglass-secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="seaglass-secrets.xml" />
    </device-transfer>
</data-extraction-rules>
