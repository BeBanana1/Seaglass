<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde et transfert d'appareil depuis Android 12 (#145) : tout sauf les secrets
     chiffrés, illisibles ailleurs (la clé du Keystore ne quitte pas l'appareil). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="seaglass-secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="seaglass-secrets.xml" />
    </device-transfer>
</data-extraction-rules>
