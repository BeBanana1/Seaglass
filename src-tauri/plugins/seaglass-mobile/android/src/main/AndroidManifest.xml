<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Playback with the screen off (#24): foreground service and ExoPlayer's network lock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Metered network or not, for quality (#365): granted without a prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Updates (#24): APK installed through PackageInstaller, with confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- New releases from followed artists (#435): requested when the setting is turned on
         (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Exported: the notification, the lock screen and headphones connect to it. -->
        <service
            android:name="dev.seaglass.mobile.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- Home screen widget (#329). Exported: the launcher and the system ask it to
             render. Its buttons go through a separate, non-exported receiver. -->
        <receiver
            android:name="dev.seaglass.mobile.NowPlayingWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing" />
        </receiver>
        <receiver
            android:name="dev.seaglass.mobile.WidgetActionReceiver"
            android:exported="false" />
        <!-- Tap on the notification (#163): UI-less relay to "Now playing". Separate task
             (empty affinity): it does not stack on the app, which it brings to the
             foreground before closing. -->
        <activity
            android:name="dev.seaglass.mobile.NowPlayingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Drive mode (#193): `seaglass://drive` link (Modes and routines, other
             automations) and app shortcut (the app's `res/xml/shortcuts.xml`). Same
             UI-less relay; exported to receive the link. -->
        <activity
            android:name="dev.seaglass.mobile.DriveActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="seaglass" android:host="drive" />
            </intent-filter>
        </activity>
        <!-- Pin to play (#335): icon shortcuts (`PinShortcuts`) and `seaglass://pin/<key>`
             link (Modes and routines). Same UI-less relay. -->
        <activity
            android:name="dev.seaglass.mobile.PinActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="seaglass" android:host="pin" />
            </intent-filter>
        </activity>
        <!-- System "Share" menu and tapped TIDAL links (#203): the linked page opens in
             the app. Same UI-less relay as above; exported to receive the intent. -->
        <activity
            android:name="dev.seaglass.mobile.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="Seaglass"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Tapped `https://tidal.com/…` links (WhatsApp, browser…). No `autoVerify`: the
                 domain is not ours, Android 12+ only hands them to the app once enabled by
                 the user (Settings › Apps › TIDAL links). Only the types the app can open;
                 the rest (videos…) goes to the browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="tidal.com" />
                <data android:host="www.tidal.com" />
                <data android:host="listen.tidal.com" />
                <data android:pathPrefix="/browse/track/" />
                <data android:pathPrefix="/browse/album/" />
                <data android:pathPrefix="/browse/artist/" />
                <data android:pathPrefix="/browse/playlist/" />
                <data android:pathPrefix="/browse/mix/" />
                <data android:pathPrefix="/track/" />
                <data android:pathPrefix="/album/" />
                <data android:pathPrefix="/artist/" />
                <data android:pathPrefix="/playlist/" />
                <data android:pathPrefix="/mix/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
