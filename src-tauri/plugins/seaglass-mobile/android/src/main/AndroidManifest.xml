<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lecture écran éteint (#24) : service au premier plan et verrou réseau d'ExoPlayer. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Mises à jour (#24) : APK installé par PackageInstaller, avec confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Exporté : la notification, l'écran verrouillé et les écouteurs s'y connectent. -->
        <service
            android:name="dev.seaglass.mobile.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- Appui sur la notification (#163) : relais sans interface vers « En lecture ».
             Tâche à part (affinité vide) : elle ne s'empile pas sur l'app, qu'elle ramène
             au premier plan avant de se fermer. -->
        <activity
            android:name="dev.seaglass.mobile.NowPlayingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Mode conduite (#193) : lien `seaglass://drive` (Modes et routines, autres
             automatisations) et raccourci de l'app (`res/xml/shortcuts.xml` de l'app). Même
             relais sans interface ; exporté pour recevoir le lien. -->
        <activity
            android:name="dev.seaglass.mobile.DriveActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="seaglass" android:host="drive" />
            </intent-filter>
        </activity>
        <!-- Épingle à lire (#335) : raccourcis de l'icône (`PinShortcuts`) et lien
             `seaglass://pin/<clé>` (Modes et routines). Même relais sans interface. -->
        <activity
            android:name="dev.seaglass.mobile.PinActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="seaglass" android:host="pin" />
            </intent-filter>
        </activity>
        <!-- Menu « Partager » du système et liens TIDAL touchés (#203) : la page du lien
             s'ouvre dans l'app. Même relais sans interface que ci-dessus ; exporté pour
             recevoir l'intent. -->
        <activity
            android:name="dev.seaglass.mobile.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="Seaglass"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Liens `https://tidal.com/…` touchés (WhatsApp, navigateur…). Pas d'`autoVerify` :
                 le domaine n'est pas à nous, Android 12+ ne les donne à l'app qu'une fois
                 activés par l'utilisateur (Réglages › Application › Liens TIDAL). Seuls les
                 types que l'app sait ouvrir ; le reste (vidéos…) va au navigateur. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="tidal.com" />
                <data android:host="www.tidal.com" />
                <data android:host="listen.tidal.com" />
                <data android:pathPrefix="/browse/track/" />
                <data android:pathPrefix="/browse/album/" />
                <data android:pathPrefix="/browse/artist/" />
                <data android:pathPrefix="/browse/playlist/" />
                <data android:pathPrefix="/browse/mix/" />
                <data android:pathPrefix="/track/" />
                <data android:pathPrefix="/album/" />
                <data android:pathPrefix="/artist/" />
                <data android:pathPrefix="/playlist/" />
                <data android:pathPrefix="/mix/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
