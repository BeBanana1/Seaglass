{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seaglass",
  "identifier": "dev.seaglass.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Seaglass",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https://resources.tidal.com https://images.tidal.com; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Seaglass",
    "copyright": "GPL-3.0. Unofficial client, not affiliated with TIDAL.",
    "shortDescription": "Lossless music streaming client",
    "resources": {
      "mpv/seaglass.conf": "mpv/seaglass.conf",
      "../LICENSE": "licenses/Seaglass-GPL-3.0.txt",
      "licenses/mpv.txt": "licenses/mpv.txt"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "installerHooks": "nsis/hooks.nsh",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
