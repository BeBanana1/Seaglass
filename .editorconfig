# Shared editor settings. Formatting itself is done by `cargo fmt` (Rust) and Prettier
# (frontend, `pnpm format`); this file covers what they do not, and the editors.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[*.{kt,kts,gradle}]
indent_size = 4

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf
