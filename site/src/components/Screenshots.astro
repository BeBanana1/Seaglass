---
// Screenshots of the home page: the README's (docs/images/, copied to src/assets/screenshots/ by
// scripts/assets.mjs). Through astro:assets (#48): each one in several widths, so a phone does
// not download the 2160 px file.
import { Image } from "astro:assets";
import playlist from "../assets/screenshots/playlist-seaglass.webp";
import album from "../assets/screenshots/album-estampe.webp";
import nowPlaying from "../assets/screenshots/now-playing-cassette.webp";

const WIDTHS = [480, 720, 960, 1440, 2160];
const shots = [
  {
    src: playlist,
    alt: "A playlist in the Seaglass theme",
    wide: true,
    sizes: "(min-width: 72rem) 62rem, 92vw",
  },
  {
    src: album,
    alt: "An album in the light Estampe theme",
    sizes: "(min-width: 72rem) 31rem, (min-width: 40rem) 46vw, 92vw",
  },
  {
    src: nowPlaying,
    alt: "Now playing with the signal path, Cassette theme",
    sizes: "(min-width: 72rem) 31rem, (min-width: 40rem) 46vw, 92vw",
  },
];
---

<div class="sg-shots not-content">
  {
    shots.map((s) => (
      <Image
        class:list={{ wide: s.wide }}
        src={s.src}
        alt={s.alt}
        widths={WIDTHS}
        sizes={s.sizes}
        format="webp"
        loading={s.wide ? "eager" : "lazy"}
        fetchpriority={s.wide ? "high" : "auto"}
      />
    ))
  }
</div>
<p class="sg-caption">Seaglass, Estampe and Cassette: 3 of the 23 themes.</p>
