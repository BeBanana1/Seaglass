# Copy to `.env` at the repository root (gitignored, never committed) and fill in.
# Format: KEY=value, one per line; `#` at the start of a line = comment.
# An empty or missing variable simply turns off the feature concerned.
#
# `.env` is read at BUILD time by `src-tauri/build.rs` (values embedded in the
# binary), and by `spike/play.py`. An environment variable with the same name set when
# launching the app wins (see the "At app launch" section below).
# The relay and the CI runner have their own file: `relay/.env.example`, `ci/.env.example`.

# --- TIDAL ----------------------------------------------------------------------------
# PKCE client identifiers (see "TIDAL client identifiers" in README.md and docs/tidal.md).
# Required to sign in.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# --- Online Jam and playback handoff (optional, #25, #452) ----------------------------
# Relay address (`https://host[:port][/path]`, no trailing `/`), offered by default in
# Settings › Application › Relay. Without an address or a key: local Jam only.
SEAGLASS_RELAY_BASE_URL=
# The app's build key: the same as SEAGLASS_RELAY_KEY in the relay's `.env`.
# Generate: openssl rand -hex 32
SEAGLASS_RELAY_KEY=

# --- Updates (optional, #452, #489) ---------------------------------------------------
# Public folder of the manifests (`latest.json`, `android.json`) and packages, for example
# https://example.org/updates. Required by the release scripts, which read it here
# (or from the environment) and build it into the app. Empty: no update offered.
SEAGLASS_UPDATE_BASE_URL=
# Updater public key (content of the `.pub` from `tauri signer generate`). Usually not
# needed: the release scripts read it next to the private key. Without it, the desktop
# app offers no update.
SEAGLASS_UPDATER_PUBKEY=

# --- Gitea release (optional, scripts/gitea-release.ps1) ------------------------------
# Read here or from the environment; without them, use -SkipGiteaRelease.
# SEAGLASS_GITEA_URL=https://git.example.org
# SEAGLASS_GITEA_REPO=owner/Seaglass

# --- Discord presence (optional, #215) ------------------------------------------------
# Numeric identifier of the Discord application. Missing: setting hidden.
DISCORD_CLIENT_ID=

# ======================================================================================
# Variables read elsewhere than in `.env`: reference only, to set in the environment
# (PowerShell session, user variables). Uncommenting them here does nothing.
# ======================================================================================

# --- At app launch (tests, troubleshooting) -------------------------------------------
# SEAGLASS_MPV_PATH=C:\path\to\mpv.exe          # mpv to use instead of the bundled one / the one in PATH
# SEAGLASS_RELAY_URL=ws://127.0.0.1:47880/host  # full relay URL (ws:// allowed), wins over the settings
# SEAGLASS_RELAY_KEY=                           # relay key, wins over the built-in key
# SEAGLASS_UPDATE_URL=                          # desktop update manifest, wins over the built-in address
# TIDAL_CLIENT_ID= / TIDAL_CLIENT_SECRET=       # win over the built-in identifiers
# DISCORD_CLIENT_ID=                            # wins over the built-in identifier

# --- Release scripts (scripts/*.ps1, see docs/release.md) -----------------------------
# SEAGLASS_RELEASE_DEST=                 # publication target (local folder, UNC or scp target), required with -Publish
# SEAGLASS_SITE_DEST=                    # website target (same forms), for scripts/publish-site.ps1 (#517)
# SEAGLASS_SIGNING_KEY=                  # updater private key (default: ~/.tauri/seaglass.key)
# SEAGLASS_MPV_PATH=                     # mpv.exe to bundle, matching mpv.lock (default: the one in PATH)
# SEAGLASS_GITEA_TOKEN=                  # otherwise the "seaglass-gitea-token" Credential Manager entry
# Android (release-android.ps1)
# SEAGLASS_ANDROID_KEYSTORE=             # default: ~/.android/seaglass-release.jks
# SEAGLASS_ANDROID_KEY_ALIAS=            # default: seaglass
# SEAGLASS_ANDROID_KEY_PASSWORD=         # otherwise Credential Manager or typed
# ANDROID_HOME= / NDK_HOME= / JAVA_HOME= # defaults: SDK in %LOCALAPPDATA%, newest NDK, keytool from PATH
# Linux (release-linux.ps1, build in WSL)
# SEAGLASS_LINUX_DISTRO=                 # default: Ubuntu-22.04
# SEAGLASS_LINUX_GLIBC_MAX=              # default: 2.35
