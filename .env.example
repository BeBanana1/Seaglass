# Copier en `.env` à la racine du dépôt (gitignoré, jamais commité) et remplir.
# Format : CLE=valeur, une par ligne ; `#` en début de ligne = commentaire.
# Une variable vide ou absente coupe simplement la fonction concernée.
#
# `.env` est lu à la COMPILATION par `src-tauri/build.rs` (valeurs embarquées dans le
# binaire), et par `spike/play.py`. Une variable d'environnement du même nom posée au
# lancement de l'app l'emporte (voir la section « Au lancement » plus bas).
# Les relais et le runner CI ont leur propre fichier : `relay/.env.example`, `ci/.env.example`.

# --- TIDAL ----------------------------------------------------------------------------
# Identifiants du client PKCE (voir docs/tidal.md). Requis pour se connecter.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# --- Jam en ligne et transfert de lecture (facultatif, #25, #452) ---------------------
# Adresse du relais (`https://hôte[:port][/chemin]`, sans `/` final), proposée par
# défaut dans Réglages › Application › Relais. Sans adresse ou sans clé : Jam locale seulement.
SEAGLASS_RELAY_BASE_URL=
# Clé de build de l'app : la même que SEAGLASS_RELAY_KEY du `.env` du relais.
# Générer : openssl rand -hex 32
SEAGLASS_RELAY_KEY=

# --- Mises à jour (facultatif, #452) --------------------------------------------------
# Dossier public des manifestes (`latest.json`, `android.json`) et des paquets.
# Laisser vide en développement : l'app ne propose alors aucune mise à jour.
# Les scripts de release posent cette variable eux-mêmes (elle l'emporte sur `.env`).
SEAGLASS_UPDATE_BASE_URL=

# --- Présence Discord (facultatif, #215) ----------------------------------------------
# Identifiant numérique de l'application Discord. Absent : réglage masqué.
DISCORD_CLIENT_ID=

# ======================================================================================
# Variables lues ailleurs que dans `.env` : référence seulement, à poser dans
# l'environnement (session PowerShell, variables utilisateur). Les décommenter ici ne
# sert à rien.
# ======================================================================================

# --- Au lancement de l'app (tests, dépannage) -----------------------------------------
# SEAGLASS_MPV_PATH=C:\chemin\vers\mpv.exe      # mpv à utiliser au lieu de celui embarqué / du PATH
# SEAGLASS_RELAY_URL=ws://127.0.0.1:47880/host  # relais complet (ws:// permis), l'emporte sur les réglages
# SEAGLASS_RELAY_KEY=                           # clé du relais, l'emporte sur la clé compilée
# SEAGLASS_UPDATE_URL=                          # manifeste des mises à jour du bureau, l'emporte sur l'adresse compilée
# TIDAL_CLIENT_ID= / TIDAL_CLIENT_SECRET=       # l'emportent sur les identifiants compilés
# DISCORD_CLIENT_ID=                            # l'emporte sur l'identifiant compilé

# --- Scripts de release (scripts/*.ps1, voir docs/release.md) -------------------------
# SEAGLASS_RELEASE_DEST=                 # destination de publication (dossier local, UNC ou cible), requis avec -Publish
# SEAGLASS_UPDATE_BASE_URL=              # défaut : https://updates.bebanana.ch/seaglass
# SEAGLASS_SIGNING_KEY=                  # clé privée de l'updater (défaut : ~/.tauri/seaglass.key)
# SEAGLASS_MPV_PATH=                     # mpv.exe à embarquer, conforme à mpv.lock (défaut : celui du PATH)
# SEAGLASS_GITEA_URL=                    # défaut : https://git.bebanana.ch
# SEAGLASS_GITEA_REPO=                   # défaut : bebanana/Seaglass
# SEAGLASS_GITEA_TOKEN=                  # sinon entrée « seaglass-gitea-token » du Gestionnaire d'identifiants
# Android (release-android.ps1)
# SEAGLASS_ANDROID_KEYSTORE=             # défaut : ~/.android/seaglass-release.jks
# SEAGLASS_ANDROID_KEY_ALIAS=            # défaut : seaglass
# SEAGLASS_ANDROID_KEY_PASSWORD=         # sinon Gestionnaire d'identifiants ou saisie
# ANDROID_HOME= / NDK_HOME= / JAVA_HOME= # défauts : SDK de %LOCALAPPDATA%, NDK le plus récent, keytool du PATH
# Linux (release-linux.ps1, build dans WSL)
# SEAGLASS_LINUX_DISTRO=                 # défaut : Ubuntu-22.04
# SEAGLASS_LINUX_GLIBC_MAX=              # défaut : 2.35
