# Clé de build de l'app : la même valeur que SEAGLASS_RELAY_KEY dans le .env de l'app.
# Générer : openssl rand -hex 32
SEAGLASS_RELAY_KEY=
# Port local (127.0.0.1) que Caddy joint, si 47880 est déjà pris.
# RELAY_PORT=47880
# Adresse publique du relais (obligatoire), celle que l'app compile dans
# SEAGLASS_RELAY_BASE_URL. Exemple : https://jam.example.org
RELAY_PUBLIC_URL=
