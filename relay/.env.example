# The app's build key: the same value as SEAGLASS_RELAY_KEY in the app's .env.
# Generate: openssl rand -hex 32
SEAGLASS_RELAY_KEY=
# Local port (127.0.0.1) that Caddy reaches, if 47880 is already taken.
# RELAY_PORT=47880
# Public address of the relay (required), the one the app builds in as
# SEAGLASS_RELAY_BASE_URL. Example: https://jam.example.org
RELAY_PUBLIC_URL=
